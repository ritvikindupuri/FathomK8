# Fine-grained or classic token with read access to repository contents,
# metadata, and pull requests. Never commit a real token.
GITHUB_TOKEN=

# Required for POST /api/webhooks/github. Polling still runs without it.
GITHUB_WEBHOOK_SECRET=

# GitHub user whose public repositories are discovered.
GITHUB_OWNER=ritvikindupuri

# Milliseconds between SHA checks when GITHUB_TOKEN is set, including when a webhook is set. 0 disables polling.
POLL_INTERVAL_MS=120000
